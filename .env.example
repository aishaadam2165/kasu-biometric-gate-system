# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kasu_biometric_gate?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Admin seed credentials (used only by scripts/seedAdmin.js)
ADMIN_EMAIL=admin@kasu.edu.ng
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=System Administrator

# App
NEXT_PUBLIC_APP_NAME="KASU Biometric Gate Access"

# Optional: face-api.js model source. Defaults to a CDN if unset. Set this
# to /models (and copy node_modules/@vladmandic/face-api/model into
# public/models) to run fully offline — see Step 4 README.
# NEXT_PUBLIC_FACE_MODELS_URL=/models
